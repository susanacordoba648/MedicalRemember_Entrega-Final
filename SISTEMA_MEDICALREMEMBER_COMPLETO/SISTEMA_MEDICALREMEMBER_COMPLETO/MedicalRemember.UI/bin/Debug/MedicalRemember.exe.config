<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <!-- Cadena de conexión a la base de datos.
         Cambia "Server" si tu SQL Server no es la instancia local por defecto
         (por ejemplo: Server=.\SQLEXPRESS). -->
    <connectionStrings>
        <add name="MedicalRememberDB"
             connectionString="Server=.;Database=MedicalRememberDB;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
